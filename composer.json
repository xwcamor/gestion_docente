{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "docente/gestion-documentacion-academica",
  "type": "project",
  "description": "Sistema de gestión docente por profesor, ciclo, grupo, curso y modalidad TEC/TALL.",
  "keywords": ["laravel", "docentes", "excel", "mysql"],
  "license": "proprietary",
  "require": {
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "laravel/framework": "^13.0",
    "phpoffice/phpspreadsheet": "^5.0",
    "php": "^8.3",
    "smalot/pdfparser": "^2.13.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
